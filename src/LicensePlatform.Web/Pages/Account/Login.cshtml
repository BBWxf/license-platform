@page
@model LicensePlatform.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "管理员登录";
}

<div class="auth-shell">
    <div class="auth-intro">
        <div class="eyebrow">软件授权 · 统一管理</div>
        <h2>把授权管理，<br />变得井然有序。</h2>
        <p>从产品配置到卡密发放，从设备绑定到操作审计，在一个工作台中清晰掌握。</p>
        <div class="auth-features" aria-label="平台功能">
            <span>多产品管理</span>
            <span>一密一设备</span>
            <span>审计追踪</span>
        </div>
    </div>
    <section class="auth-card" aria-labelledby="login-title">
        <div class="mb-4">
            <div class="auth-access-label">管理员入口</div>
            <h1 id="login-title">管理员登录</h1>
            <p class="text-muted mb-0">请输入唯一的超级管理员账号。</p>
        </div>
        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input asp-for="ReturnUrl" type="hidden" />
            <div class="mb-3">
                <label asp-for="Input.UserName" class="form-label"></label>
                <input asp-for="Input.UserName" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Input.UserName" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <button class="btn btn-primary w-100" type="submit">登录管理后台</button>
        </form>
        <p class="form-text auth-help mb-0">
            忘记密码时，请登录服务器执行<br />
            <code>sudo licensectl reset-admin-password</code>。
        </p>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
