@page
@model LicensePlatform.Web.Pages.Admin.Audit.IndexModel
@{
    ViewData["Title"] = "审计日志";
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.Result.TotalCount / (double)Model.Result.PageSize));
}

<div class="page-heading">
    <div>
        <h1>审计日志</h1>
        <p>记录登录、产品、发卡、禁用、延期和解绑等管理操作。</p>
    </div>
</div>

<section class="panel mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-8">
            <label class="form-label" for="action">操作类型</label>
            <input class="form-control mono" id="action" name="action" value="@Model.ActionFilter" placeholder="例如 LICENSE.DISABLE；留空显示全部" />
        </div>
        <div class="col-md-4">
            <button class="btn btn-primary w-100" type="submit">筛选</button>
        </div>
    </form>
</section>

<section class="panel">
@if (Model.Result.Items.Count == 0)
{
    <div class="empty-state">没有符合条件的审计事件。</div>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>UTC 时间</th><th>操作者</th><th>操作</th><th>对象</th><th>结果</th><th>来源 IP</th><th>摘要</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Result.Items)
            {
                <tr>
                    <td class="text-nowrap">@item.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@item.Actor</td>
                    <td><code>@item.Action</code></td>
                    <td>@item.TargetType @item.TargetId</td>
                    <td>@item.Result</td>
                    <td><code>@item.SourceIp</code></td>
                    <td>@(item.Summary ?? "-")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <nav class="d-flex justify-content-between align-items-center mt-3">
        <span class="text-muted">共 @Model.Result.TotalCount 条，第 @Model.Result.Page / @totalPages 页</span>
        <div class="btn-group">
            <a class="btn btn-sm btn-outline-secondary @(Model.Result.Page <= 1 ? "disabled" : "")" asp-route-action="@Model.ActionFilter" asp-route-pageNumber="@(Model.Result.Page - 1)">上一页</a>
            <a class="btn btn-sm btn-outline-secondary @(Model.Result.Page >= totalPages ? "disabled" : "")" asp-route-action="@Model.ActionFilter" asp-route-pageNumber="@(Model.Result.Page + 1)">下一页</a>
        </div>
    </nav>
}
</section>
