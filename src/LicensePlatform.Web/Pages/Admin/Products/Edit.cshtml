@page "{id:guid?}"
@model LicensePlatform.Web.Pages.Admin.Products.EditModel
@{
    ViewData["Title"] = Model.Id is null ? "新建产品" : "编辑产品";
}

<div class="page-heading">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p>产品公开编号和签名密钥由系统生成，不需要手工设置。</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="Index">返回列表</a>
</div>

<section class="panel" style="max-width: 760px">
    <form method="post">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="Input.Name" class="form-label">产品名称</label>
            <input asp-for="Input.Name" class="form-control" maxlength="120" />
            <span asp-validation-for="Input.Name" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Input.LicensePrefix" class="form-label">卡密前缀</label>
            <input asp-for="Input.LicensePrefix" class="form-control text-uppercase mono" maxlength="8" />
            <div class="form-text">2～8 位大写字母或数字，仅用于人工识别，不计入卡密随机强度。</div>
            <span asp-validation-for="Input.LicensePrefix" class="text-danger"></span>
        </div>

        <button class="btn btn-primary" type="submit">保存产品</button>
        <a class="btn btn-link" asp-page="Index">取消</a>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
