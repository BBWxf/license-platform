@page
@model LicensePlatform.Web.Pages.Admin.Products.IndexModel
@{
    ViewData["Title"] = "产品管理";
}

<div class="page-heading">
    <div>
        <h1>产品管理</h1>
        <p>管理产品、卡密前缀与客户端配置。每个产品使用独立的公开编号和服务端签名密钥。</p>
    </div>
    <a class="btn btn-primary" asp-page="Edit">新建产品</a>
</div>

<section class="panel">
    <div class="panel-heading">
        <h2 class="h5 mb-0">产品列表</h2>
    </div>
    @if (Model.Products.Count == 0)
    {
        <div class="empty-state">
            <h3 class="h6">还没有产品</h3>
            <p>先创建产品，再为产品生成卡密并下载客户端配置。</p>
            <a class="btn btn-primary" asp-page="Edit">创建第一个产品</a>
        </div>
    }
    else
    {
        <div class="table-responsive" role="region" aria-label="产品列表，可横向滚动" tabindex="0">
            <table class="table">
                <thead>
                <tr>
                    <th scope="col">产品</th>
                    <th scope="col">公开编号</th>
                    <th scope="col">卡密前缀</th>
                    <th scope="col" class="numeric">卡密数</th>
                    <th scope="col" class="numeric">活动设备</th>
                    <th scope="col">状态</th>
                    <th scope="col" class="text-end">操作</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr>
                        <td>
                            <div class="cell-primary">@product.Name</div>
                            <div class="cell-secondary">创建于 @product.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd") UTC</div>
                        </td>
                        <td class="cell-id"><code>@product.PublicCode</code></td>
                        <td class="cell-id"><code>@product.LicensePrefix</code></td>
                        <td class="numeric">@product.LicenseCount</td>
                        <td class="numeric">@product.ActiveBindingCount</td>
                        <td>
                            <span class="badge-state @(product.Enabled ? "badge-enabled" : "badge-disabled")">
                                @(product.Enabled ? "已启用" : "已停用")
                            </span>
                        </td>
                        <td>
                            <div class="table-actions justify-content-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-page="Edit" asp-route-id="@product.Id">编辑</a>
                                <a class="btn btn-sm btn-outline-secondary" asp-page-handler="ClientConfig" asp-route-id="@product.Id">客户端配置</a>
                                <form method="post" asp-page-handler="Toggle">
                                    <input type="hidden" name="id" value="@product.Id" />
                                    <input type="hidden" name="enabled" value="@(!product.Enabled)" />
                                    <button class="btn btn-sm @(product.Enabled ? "btn-outline-danger" : "btn-outline-primary")" type="submit">
                                        @(product.Enabled ? "停用" : "启用")
                                    </button>
                                </form>
                                <button class="btn btn-sm btn-outline-danger" type="button" data-bs-toggle="collapse" data-bs-target="#delete-product-@product.Id" aria-controls="delete-product-@product.Id" aria-expanded="false">删除</button>
                            </div>
                        </td>
                    </tr>
                    <tr class="collapse" id="delete-product-@product.Id">
                        <td colspan="7">
                            <div class="danger-panel">
                                <h3 class="h6">确认删除产品：@product.Name</h3>
                                <p class="small text-muted">将永久删除此产品及其全部 @product.LicenseCount 张卡密、设备绑定、激活挑战、批次、导出存档和签名密钥，无法撤销。审计记录保留。若只是暂停使用，请选择“停用”。</p>
                                <p class="small text-muted">已下载文件和备份不会被撤回；已签发的离线租约最多可继续使用到 6 小时租约到期。</p>
                                <form method="post" asp-page-handler="Delete">
                                    <input type="hidden" name="id" value="@product.Id" />
                                    <div class="form-check mb-3">
                                        <input class="form-check-input" type="checkbox" id="delete-product-confirmed-@product.Id" name="confirmed" value="true" required />
                                        <label class="form-check-label" for="delete-product-confirmed-@product.Id">我确认永久删除此产品及其全部卡密</label>
                                    </div>
                                    <div class="table-actions">
                                        <button class="btn btn-sm btn-danger" type="submit">确认删除产品</button>
                                        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#delete-product-@product.Id" aria-controls="delete-product-@product.Id" aria-expanded="false">取消</button>
                                    </div>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
