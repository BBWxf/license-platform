@page
@model LicensePlatform.Web.Pages.Admin.Batches.CreateModel
@{
    ViewData["Title"] = "生成卡密";
}

<div class="page-heading">
    <div>
        <h1>生成卡密</h1>
        <p>有效期从每张卡第一次成功激活时开始计算。</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="Index">返回批次</a>
</div>

<section class="panel" style="max-width: 820px">
    <div class="alert alert-warning">
        生成后的 CSV 只能下载一次，并在 15 分钟后自动删除。请立即保存到安全位置。
    </div>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row g-3">
            <div class="col-md-7">
                <label asp-for="Input.ProductId" class="form-label">产品</label>
                <select asp-for="Input.ProductId" class="form-select">
                    <option value="">请选择产品</option>
                    @foreach (var product in Model.Products)
                    {
                        <option value="@product.Id">@product.Name</option>
                    }
                </select>
                <span asp-validation-for="Input.ProductId" class="text-danger"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Input.Count" class="form-label">生成数量</label>
                <input asp-for="Input.Count" class="form-control" min="1" max="10000" />
                <span asp-validation-for="Input.Count" class="text-danger"></span>
            </div>
            <div class="col-md-7">
                <label asp-for="Input.Name" class="form-label">批次名称</label>
                <input asp-for="Input.Name" class="form-control" maxlength="120" placeholder="例如：2026 年 8 月正式用户" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Input.ValidityKind" class="form-label">卡类型</label>
                <select asp-for="Input.ValidityKind" class="form-select" id="validity-kind">
                    <option value="Day">天卡</option>
                    <option value="Month">月卡（30 天）</option>
                    <option value="Year">年卡（365 天）</option>
                    <option value="Permanent">永久卡</option>
                </select>
            </div>
            <div class="col-md-5" id="duration-units-row">
                <label asp-for="Input.DurationUnits" class="form-label">时长数量</label>
                <input asp-for="Input.DurationUnits" class="form-control" min="1" max="3650" />
                <div class="form-text">例如 3 张月卡中的“3”应填在数量；三个月卡的“3”填在这里。</div>
                <span asp-validation-for="Input.DurationUnits" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Input.Note" class="form-label">备注（可选）</label>
                <textarea asp-for="Input.Note" class="form-control" rows="3" maxlength="500"></textarea>
            </div>
        </div>

        <hr class="my-4" />
        <button class="btn btn-primary" type="submit">生成并准备下载</button>
        <a class="btn btn-link" asp-page="Index">取消</a>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const kind = document.getElementById('validity-kind');
            const row = document.getElementById('duration-units-row');
            const update = () => row.hidden = kind.value === 'Permanent';
            kind.addEventListener('change', update);
            update();
        })();
    </script>
}
