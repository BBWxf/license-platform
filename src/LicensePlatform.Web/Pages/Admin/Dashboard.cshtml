@page
@model LicensePlatform.Web.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "系统概览";
}

<div class="page-heading">
    <div>
        <div class="eyebrow">管理工作台</div>
        <h1>系统概览</h1>
        <p>产品、卡密与设备绑定，一目了然。</p>
    </div>
    <div class="heading-actions">
        <a class="btn btn-outline-secondary" asp-page="/Admin/Products/Edit">新建产品</a>
        <a class="btn btn-primary" asp-page="/Admin/Batches/Create">生成卡密</a>
    </div>
</div>

<section class="metrics-grid" aria-label="授权统计">
    <div class="metric-card" data-stat="products">
        <div class="metric-label">产品</div>
        <div class="metric-value">@Model.Snapshot.ProductCount</div>
        <div class="metric-help">已创建的软件产品</div>
    </div>
    <div class="metric-card" data-stat="unused">
        <div class="metric-label">未激活卡密</div>
        <div class="metric-value">@Model.Snapshot.UnusedLicenseCount</div>
        <div class="metric-help">有效期尚未开始</div>
    </div>
    <div class="metric-card" data-stat="active">
        <div class="metric-label">有效授权</div>
        <div class="metric-value">@Model.Snapshot.ActiveLicenseCount</div>
        <div class="metric-help">当前可用的授权</div>
    </div>
    <div class="metric-card" data-stat="expired">
        <div class="metric-label">已过期</div>
        <div class="metric-value">@Model.Snapshot.ExpiredLicenseCount</div>
        <div class="metric-help">业务有效期已结束</div>
    </div>
    <div class="metric-card" data-stat="bindings">
        <div class="metric-label">活动设备</div>
        <div class="metric-value">@Model.Snapshot.ActiveBindingCount</div>
        <div class="metric-help">当前绑定设备数</div>
    </div>
</section>

<div class="dashboard-grid">
    <section class="panel" aria-labelledby="recent-activity-title">
        <div class="panel-heading">
            <div>
                <h2 id="recent-activity-title" class="mb-1">最近操作</h2>
                <p class="mb-0">包含管理员、授权客户端和系统事件。时间均为 UTC；“已记录”不代表操作成功。</p>
            </div>
            <a asp-page="/Admin/Audit/Index">全部日志 <span aria-hidden="true">→</span></a>
        </div>
        @if (Model.Snapshot.RecentAuditEvents.Count == 0)
        {
            <div class="empty-state">尚无审计记录。管理员、授权客户端和系统的事件会在这里展示。</div>
        }
        else
        {
            <div class="table-responsive audit-table-scroll" role="region" aria-label="最近操作记录，可横向滚动" tabindex="0">
                <table class="table audit-table">
                    <thead>
                    <tr>
                        <th scope="col">时间（UTC）</th>
                        <th scope="col">操作与说明</th>
                        <th scope="col">对象</th>
                        <th scope="col">记录详情</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Snapshot.RecentAuditEvents)
                    {
                        var presentation = LicensePlatform.Web.Services.AuditPresentationFormatter.For(item);
                        <tr>
                            <td class="table-time"><time datetime="@(item.CreatedAt.ToUniversalTime().ToString("O"))">@item.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</time></td>
                            <td class="audit-operation">
                                <div class="cell-primary">@presentation.ActionLabel</div>
                                <div class="cell-secondary audit-description">@presentation.Description</div>
                            </td>
                            <td class="audit-target">@presentation.TargetLabel</td>
                            <td class="audit-record">
                                <span class="badge-state badge-neutral">已记录</span>
                                <details class="audit-details">
                                    <summary>查看详情<span class="visually-hidden">：@presentation.ActionLabel</span></summary>
                                    <dl class="audit-detail-list">
                                        <dt>操作代码</dt>
                                        <dd><code>@item.Action</code></dd>
                                        <dt>对象类型代码</dt>
                                        <dd><code>@item.TargetType</code></dd>
                                        @foreach (var detail in presentation.Details)
                                        {
                                            <dt>@detail.Label</dt>
                                            <dd>@detail.Value</dd>
                                        }
                                    </dl>
                                </details>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
    <aside class="panel" aria-labelledby="quick-links-title">
        <div class="panel-heading"><h2 id="quick-links-title" class="mb-0">常用入口</h2></div>
        <div class="quick-links">
            <a class="quick-link" asp-page="/Admin/Products/Index">
                <span><strong>管理产品</strong><small>配置产品与客户端公钥</small></span>
                <span class="quick-link-arrow" aria-hidden="true">→</span>
            </a>
            <a class="quick-link" asp-page="/Admin/Batches/Index">
                <span><strong>卡密批次</strong><small>查看批次与导出状态</small></span>
                <span class="quick-link-arrow" aria-hidden="true">→</span>
            </a>
            <a class="quick-link" asp-page="/Admin/Licenses/Index">
                <span><strong>查询授权</strong><small>查看有效期与设备绑定</small></span>
                <span class="quick-link-arrow" aria-hidden="true">→</span>
            </a>
        </div>
        <div class="notice-block">
            <strong>关于授权有效期</strong>
            <p>有限卡从首次成功激活开始计时。解绑设备不会重置总有效期。</p>
        </div>
    </aside>
</div>
