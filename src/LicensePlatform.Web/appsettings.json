{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": ""
  },
  "Branding": {
    "SystemName": "软件授权管理系统"
  },
  "Security": {
    "AllowInsecureHttp": false,
    "HttpsPort": 443,
    "ClientRequestClockSkewSeconds": 300,
    "BootstrapAdminUsername": "admin",
    "CardLookupKeyFile": "/run/secrets/card_lookup_key",
    "MasterEncryptionKeyFile": "/run/secrets/master_encryption_key",
    "DataProtectionPath": "/var/lib/license-platform/data-protection",
    "CookieName": "LicensePlatform.Admin"
  },
  "Exports": {
    "LifetimeMinutes": 15,
    "MaximumBatchSize": 10000
  },
  "RateLimits": {
    "LoginAttemptsPerMinute": 5,
    "ChallengesPerMinutePerIp": 60,
    "ClientRequestsPerMinutePerIp": 120
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
